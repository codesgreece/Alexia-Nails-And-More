DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-in-production-use-openssl-rand"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@alexianails.gr"
ADMIN_PASSWORD="change-me"

# Vercel notes:
# - Set AUTH_SECRET (required)
# - Set NEXTAUTH_URL to your deployment URL
# - DATABASE_URL can stay file:./dev.db; runtime copies seeded DB to /tmp on Vercel
# - Set ADMIN_EMAIL / ADMIN_PASSWORD before first deploy so seed creates the admin
