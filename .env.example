DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-in-production-use-openssl-rand"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@alexianails.gr"
ADMIN_PASSWORD="AlexiaAdmin2026!"

# Vercel (required for /admin login):
# 1. Project → Settings → Environment Variables
# 2. Add AUTH_SECRET = (run: openssl rand -base64 32)
# 3. Add NEXTAUTH_URL = https://YOUR-APP.vercel.app
# 4. Optional: ADMIN_EMAIL / ADMIN_PASSWORD before first deploy (seed)
# 5. Redeploy after saving env vars
# DATABASE_URL can stay file:./dev.db; runtime uses /tmp copy on Vercel
